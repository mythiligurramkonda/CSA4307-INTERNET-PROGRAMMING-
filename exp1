<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Library Management System</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, sans-serif;
}

body{
background:#f5f5f5;
}

header{
background:#0d6efd;
color:white;
padding:15px;
}

nav{
display:flex;
justify-content:space-between;
align-items:center;
}

nav ul{
list-style:none;
display:flex;
}

nav ul li{
margin:0 15px;
}

nav ul li a{
color:white;
text-decoration:none;
font-weight:bold;
}

.hero{
height:450px;
background:url('https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1200&q=80');
background-size:cover;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
color:white;
text-shadow:2px 2px 5px black;
}

.hero h1{
font-size:50px;
}

.hero p{
font-size:20px;
margin:15px;
}

.btn{
padding:12px 25px;
background:#ffc107;
color:black;
text-decoration:none;
border-radius:5px;
font-weight:bold;
}

.container{
width:90%;
margin:auto;
padding:40px 0;
}

.cards{
display:flex;
justify-content:space-around;
flex-wrap:wrap;
}

.card{
background:white;
width:280px;
padding:20px;
margin:15px;
border-radius:10px;
box-shadow:0 0 10px gray;
text-align:center;
}

.card h3{
color:#0d6efd;
margin-bottom:10px;
}

.search{
text-align:center;
margin:40px;
}

.search input{
padding:10px;
width:300px;
}

.search button{
padding:10px 20px;
background:#0d6efd;
color:white;
border:none;
cursor:pointer;
}

footer{
background:#0d6efd;
color:white;
text-align:center;
padding:15px;
margin-top:40px;
}
</style>

</head>

<body>

<header>

<nav>

<h2>Library Management System</h2>

<ul>
<li><a href="#">Home</a></li>
<li><a href="#">Books</a></li>
<li><a href="#">Materials</a></li>
<li><a href="#">Login</a></li>
<li><a href="#">Register</a></li>
<li><a href="#">Contact</a></li>
</ul>

</nav>

</header>

<section class="hero">

<h1>Welcome to Library</h1>

<p>Search, Borrow and Download Study Materials</p>

<a href="#" class="btn">Explore Books</a>

</section>

<div class="search">

<h2>Search Books</h2>
<br>

<input type="text" placeholder="Enter Book Name">

<button>Search</button>

</div>

<div class="container">

<div class="cards">

<div class="card">
<h3>Search Books</h3>
<p>Find books by title, author and category.</p>
</div>

<div class="card">
<h3>Borrow Books</h3>
<p>Issue books online and view borrowing history.</p>
</div>

<div class="card">
<h3>Study Materials</h3>
<p>Download notes year-wise and semester-wise.</p>
</div>

<div class="card">
<h3>Check Fine</h3>
<p>View due dates and pending fines instantly.</p>
</div>

</div>

</div>

<footer>

<p>© 2026 Library Management System | Developed by Student</p>

</footer>

</body>
</html>
